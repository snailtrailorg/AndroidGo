<?xml version="1.0" encoding="utf-8"?>
<!-- Two Go stones on a board -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Black stone at (62,46) — upper-right of centre -->
    <path android:pathData="M62,39 a7,7 0 1,0 0,14 a7,7 0 1,0 0,-14">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="60.5" android:centerY="41.5"
                android:gradientRadius="7"
                android:startColor="#FF555555"
                android:endColor="#FF111111" />
        </aapt:attr>
    </path>
    <path android:pathData="M59,40 a3.5,2 0 1,0 0,4 a3.5,4 0 0,1 0,-4"
        android:fillColor="#33FFFFFF" />

    <!-- White stone at (46,62) — lower-left of centre -->
    <path android:pathData="M46,55 a7,7 0 1,0 0,14 a7,7 0 1,0 0,-14">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="44.5" android:centerY="60"
                android:gradientRadius="7"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFC8C8C8" />
        </aapt:attr>
    </path>
    <path android:pathData="M43,58 a3.5,2 0 1,0 0,4 a3.5,4 0 0,1 0,-4"
        android:fillColor="#1A000000" />
</vector>
